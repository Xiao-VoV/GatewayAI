# 本地开发配置，复制为 server/.env 后使用。
# 注意：server/.env 已被 .gitignore 忽略。

# 监听地址；生产改成 0.0.0.0:8080
GW_BIND=127.0.0.1:8080

# PostgreSQL；docker compose up -d postgres 后可用。
# 留空表示不启用 DB（identity 端点返回 503，仅用于 smoke test）
GW_DATABASE_URL=postgres://gw:gw@127.0.0.1:5432/gw

# 日志级别
GW_LOG=gw_server=debug,tower_http=info

# 启动时自动执行 sqlx 迁移；生产可设为 false
GW_MIGRATE=true

# identity Session Cookie 是否加 Secure（生产/HTTPS 必须 true；本地 HTTP 可 false）
GW_COOKIE_SECURE=false

# 可选：设置后 POST /api/admin/auth/setup 必须带 X-Setup-Token。
# 生产远程部署建议开启，使用 >=16 字符的高熵随机值。
# GW_SETUP_TOKEN=

# 注意：identity 会话固定 12h（D18），没有 GW_SESSION_TTL_SECS。

# providers 主密钥（上游凭证 AES-256-GCM 加密）。
# 二选一：GW_MASTER_KEY（64 位 hex 或 44 字符 base64，32 字节），或
# GW_MASTER_KEY_FILE（默认 ./data/master.key，相对 server 工作目录；0600）。
# 不设置时会首次启动自动生成 0600 文件；生产/多实例必须预置同一密钥并单独备份。
# GW_MASTER_KEY=
# GW_MASTER_KEY_FILE=./data/master.key
