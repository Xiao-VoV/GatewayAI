# gw 开发环境启动配置
# 首次运行 ./scripts/dev-start.sh 会自动复制为 scripts/dev.env（已 gitignore）。
# 修改后重启：./scripts/dev-start.sh restart

# ---------- 组件开关 ----------
START_POSTGRES=true
START_SERVER=true
START_ADMIN=true
# browser | desktop | none
CLIENT_MODE=browser
OPEN_BROWSER=true

# ---------- 端口 ----------
# 服务端必须是 8080：admin/client 的 Vite 代理固定为 127.0.0.1:8080。
SERVER_PORT=8080
ADMIN_PORT=5173
CLIENT_PORT=5175

# ---------- PostgreSQL ----------
# START_POSTGRES=true 时执行 docker compose up -d $POSTGRES_SERVICE
POSTGRES_SERVICE=postgres
POSTGRES_USER=gw
POSTGRES_DB=gw
GW_DATABASE_URL=postgres://gw:gw@127.0.0.1:5432/gw

# ---------- 服务端 ----------
GW_MIGRATE=true
GW_COOKIE_SECURE=false
GW_LOG=gw_server=info,tower_http=info
# GW_MASTER_KEY=           # 留空则自动生成/使用 server/data/master.key
# GW_SETUP_TOKEN=          # 生产建议设置，16+ 字符高熵值

# ---------- 运行 ----------
# 首次 cargo 编译可能较久，server readyz 最多等这么多秒
WAIT_TIMEOUT=180
# stop 时是否一并停止 docker compose 的 PostgreSQL（默认保留数据容器）
STOP_POSTGRES=false
